{
  "name": "mota-24-optimality-lab",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first static data and bounded exact search for Mota 24",
  "license": "MIT",
  "scripts": {
    "bootstrap": "node tools/bootstrap.mjs",
    "test": "node --test tests/import.test.mjs && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "experiment": "python3 src/search.py generated/tower.json --out generated/mt1.json",
    "flash:fetch": "python3 tools/fetch_swf.py mhhf",
    "flash:verify": "python3 tools/flash_milestone.py generated/private/mhhf.swf --check experiments/flash-M4.json",
    "ruffle:fetch": "python3 tools/fetch_ruffle.py",
    "ruffle:verify": "python3 tools/ruffle_milestone.py generated/private/mhhf.swf --check experiments/ruffle-M5.json",
    "game:verify": "python3 tools/game_milestone.py generated/private/mhhf.swf --check experiments/whole-game-M6.json",
    "crossfloor:verify": "python3 tools/crossfloor_milestone.py generated/private/mhhf.swf --check experiments/crossfloor-M7.json",
    "optimization:verify": "python3 tools/search_milestone.py generated/private/mhhf.swf --check experiments/optimization-M8.json"
  },
  "dependencies": {
    "acorn": "8.15.0"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
